# Bearer key required by POST /api/ingest and GET /api/status
INGEST_API_KEY=

# Supabase project URL and service role key (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push VAPID keys for auto-pause notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Push provider contact, e.g. mailto:you@example.com
VAPID_SUBJECT=
